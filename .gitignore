.venv/
__pycache__/
*.py[cod]
out/
.feagent/
.pytest_cache/
build/
dist/
# feacore
*.egg-info/
/work/
*.msh
!benchmarks/**/*.msh
# gold-benchmark reference meshes: large, listed with sha256 in benchmarks/gold/index.json
benchmarks/gold/_meshes/
*.vtu
*.frd
*.sta
*.cvg
*.12d
spooles.out
ace_runs/
runs/
models/*
!models/.gitignore

# ACE: cached field-error references and baselines (rebuilt with python -m ace.field_error --precompute)
ace/field_refs/
ace/field_refs_gpu/
.feacore_python
.feacore_token
.feacore_autoupdate_deferrals
# feabench: solver scratch; downloaded datasets (SimJEB etc., in the root data/) are never committed (licensing + size)
*.dat
!benchmarks/**/*.dat.ref
/data/
# talk_plots/cfd: cached flow solves (rebuilt with python talk_plots/cfd/make_figures.py --resolve)
talk_plots/cfd/_cache/

# wsp: run outputs (evaluations, sessions, adapters, score cache) and the tiny test model
wsp_runs/

# Claude Code subagent worktrees
.claude/worktrees/
# swarms exported from the dashboard or ace.export_swarm (curated ones are committed under results/trained_swarms/)
swarms/
